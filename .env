# ============================================
# PLUNDERVERSE - LOCAL DEVELOPMENT ENVIRONMENT
# ============================================

# Node Environment
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql:plunderverse_user:change_me@localhost:5432/plunderverse_dev
DB_MAX_CONNECTIONS=20
DB_IDLE_TIMEOUT=30000
DB_CONNECTION_TIMEOUT=5000
DB_ENABLE_LOGGING=true

# Authentication & Security
# IMPORTANT: Generate secure random strings for production!
# You can use: openssl rand -base64 32
SESSION_SECRET=your-super-secret-session-key-min-32-chars-required
JWT_SECRET=your-jwt-secret-key-for-tokens-min-32-chars
JWT_EXPIRES_IN=7d
REFRESH_TOKEN_EXPIRES_IN=30d

# Session Configuration
SESSION_COOKIE_NAME=plunderverse.sid
SESSION_MAX_AGE=86400000

# Password & Security Settings
BCRYPT_ROUNDS=12
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_DURATION=900000

# CORS Configuration
CORS_ORIGIN=http://localhost:5000

# Crypto API (Optional - will run in MOCK MODE if not set)
# CRYPTO_API_KEY=your-crypto-api-key-here
# CRYPTO_API_URL=https://api.spacecrypto.example.com
# CRYPTO_NETWORK=testnet

# Server Configuration
PORT=5000
